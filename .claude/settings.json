{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash(pnpm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(git *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(rm *)",
      "Bash(chmod *)",
      "Bash(scripts/validate.sh)",
      "Bash(prettier *)",
      "Bash(eslint *)",
      "Bash(gh *)",
      "Bash(op *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r \".tool_input.file_path // empty\"); if echo \"$f\" | grep -qE '\\.(tsx?|jsx?)$'; then npx prettier --write \"$f\" 2>/dev/null; fi",
            "description": "Auto-format TypeScript/JavaScript files after edit"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r \".tool_input.file_path // empty\"); if echo \"$f\" | grep -qE '\\.(tsx|jsx)$'; then npx eslint --fix \"$f\" 2>/dev/null || true; fi",
            "description": "Auto-lint JSX/TSX files after edit"
          }
        ]
      }
    ]
  }
}