# TenSixtyThree environment — generated from lib/env-manifest.ts (the
# machine-checked catalog of every var the app reads). Copy to .env.
# Local dev loads this via `op run --env-file=.env`; secrets may be op://
# references. Hosted (Railway) sets these as service variables instead.

# ─── hosted-required ─────────────────────────────────────────────────────
# A hosted instance cannot boot (or cannot auth) without these. Local dev
# needs DATABASE_URL + ANTHROPIC_API_KEY; the rest only matter when
# AUTH_REQUIRED=true.

# Postgres connection string (Railway: reference the attached Postgres service).
DATABASE_URL=postgresql://tensixtythree:tensixtythree@127.0.0.1:51063/tensixtythree
# Claude API key for the Overseer chat and briefing engines.
ANTHROPIC_API_KEY=op://Cascade/Cascade Runtime/anthropic_api_key
# Better Auth signing secret (openssl rand -base64 32; never reuse the local one in prod).
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
# Public base URL of the deployment (https://<app>.up.railway.app until the domain lands).
BETTER_AUTH_URL=http://localhost:3000
# Set "true" on hosted instances to enforce sessions; unset/false is local single-user mode.
AUTH_REQUIRED=
# 54.2 — 32-byte base64 secret sealing BYOK Anthropic keys at rest (openssl rand -base64 32). Rotating it orphans stored keys (users re-enter).
ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
# 54.1 — comma-separated bootstrap allowlist: these emails may create accounts without an invite and land with the admin role. Without it, an invite-only instance has no way in.
ADMIN_EMAILS=you@example.com
# GitHub OAuth App client id (primary sign-in provider).
GITHUB_CLIENT_ID=
# GitHub OAuth App client secret.
GITHUB_CLIENT_SECRET=

# ─── hosted-optional ─────────────────────────────────────────────────────
# Enables a feature on the hosted instance; absence degrades gracefully.

# 54.2 — Resend API key for invite/OTP email. Unset: emails are logged to the server console instead (dev/local mode).
RESEND_API_KEY=
# 52.3 — enables the headless operator ops endpoint (/api/admin/ops, constant-time compared). Unset: endpoint 404s.
OPS_SECRET=
# 54.2 — From header for auth email. Default "TenSixtyThree <auth@mail.tensixtythree.com>".
EMAIL_FROM=
# Google OAuth client id (secondary sign-in provider).
GOOGLE_CLIENT_ID=
# Google OAuth client secret.
GOOGLE_CLIENT_SECRET=
# Override the Overseer chat model id (defaults in code).
CASCADE_CHAT_MODEL=
# Select the AI service implementation (default: anthropic).
CASCADE_AI_SERVICE=
# Enables the Vercel deployment panels/integrations.
VERCEL_TOKEN=
# Enables the Railway deployment panels/integrations.
RAILWAY_TOKEN=
# Comma list of sources for the version watcher's feature-proposal feed.
ANTHROPIC_FEATURE_SOURCES=

# ─── local-only ──────────────────────────────────────────────────────────
# Only meaningful on an operator machine with a filesystem fleet
# (PROJECTS_DIR scans, dispatcher shell-outs, Stop-hook spool).

# Root directory of the local project fleet for health/progress scans.
PROJECTS_DIR=~/projects
# Path to the shared kilroy-brain repo checkout.
KILROY_BRAIN_PATH=
# Path to the coqui-kickoff plugin manifest.
CASCADE_PLUGIN_JSON_PATH=
# Path to the operator's ~/.claude config for hook installs.
CASCADE_CLAUDE_CONFIG_PATH=
# Cap on concurrently dispatched Claude Code sessions.
CASCADE_MAX_CONCURRENT_SUBAGENTS=
# File path holding the Stop-hook webhook shared secret.
CASCADE_WEBHOOK_SECRET_PATH=
# Spool directory for webhook payloads when the app is down.
CASCADE_WEBHOOK_SPOOL=
# Local dev server port override used by hook installers.
CASCADE_PORT=
# Test-harness Postgres base URL (vitest rigs only).
TEST_PG_BASE_URL=

# ─── runner service only (not in the manifest; read by scripts/runner.ts) ──
# Set RUNNER_MODE=1 on the second Railway service so `pnpm start` boots the
# cloud runner instead of Next. Needs DATABASE_URL + ANTHROPIC_API_KEY too.
RUNNER_MODE=
# Fine-grained GitHub PAT: private clones, cloud/<id> branch pushes, PR creation.
GITHUB_TOKEN=
# Identity stamped on claimed Dispatch rows (default <hostname>-<pid>).
RUNNER_ID=
# Poll interval for queued cloud dispatches (default 5000).
RUNNER_POLL_MS=
# Agent SDK guardrails per run (defaults 40 turns / $5).
RUNNER_MAX_TURNS=
RUNNER_MAX_BUDGET_USD=
