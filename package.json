{
  "name": "tensixtythree",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "tsx scripts/run-dispatch-watchdog.ts || exit 0",
    "dev": "op run --env-file=.env -- next dev --turbopack -H 127.0.0.1",
    "dev:ci": "next dev --turbopack -H 127.0.0.1",
    "build": "next build",
    "start": "sh -c 'if [ \"$RUNNER_MODE\" = \"1\" ]; then tsx scripts/runner.ts; else op run --env-file=.env -- next start; fi'",
    "start:hosted": "sh -c 'if [ \"$RUNNER_MODE\" = \"1\" ]; then tsx scripts/runner.ts; else next start; fi'",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "eval": "tsx evals/run.ts",
    "eval:refresh": "tsx evals/run.ts --record",
    "validate": "bash scripts/validate.sh",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "start:runner": "tsx scripts/runner.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "patchedDependencies": {
      "@vitest/utils@4.1.2": "patches/@vitest__utils@4.1.2.patch"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.261",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@prisma/adapter-better-sqlite3": "^7.6.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.6.0",
    "better-auth": "^1.6.26",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "next": "16.2.2",
    "pg": "^8.22.0",
    "prisma": "^7.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}