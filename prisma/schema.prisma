// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id                 Int               @id @default(autoincrement())
  name               String
  slug               String            @unique
  path               String
  status             String            @default("building") // building | complete | deployed | backburner | paused | archived
  stack              String            @default("{}") // JSON string
  currentPhase       String            @default("phase-1-foundation")
  currentRequest     String?
  health             String            @default("idle") // healthy | warning | blocked | idle
  healthDetails      String            @default("{}") // JSON string
  githubRepo         String?
  autonomyMode       String            @default("semi") // full | semi | manual
  agentTeamsEnabled  Boolean           @default(false)
  prWorkflowEnabled  Boolean           @default(false)
  progressScore      Int               @default(0)
  progressDetails    String            @default("{}")
  deploymentInfo     String            @default("{}") // JSON: { url, provider, healthEndpoint }
  businessStage      String            @default("building") // building, pre-sale, active-sale, revenue, growth, internal
  projectContext     String?           // persisted context.md content — project story, stakeholders, goals
  completionCriteria String?           // persisted done.md content — what "done" means for this project
  badges             String            @default("[]") // JSON array: deployed, client, testing, awaiting-review, versioned
  themeKey           String?           // 53.4 — per-project assistant persona (theme-pack key); null = inherit global
  isDemo             Boolean           @default(false) // 54.5 — demo-seeded project
  ownerUserId        String?           // 55.2 — [54.D1] owner; null = operator fleet (admin/local visibility)
  deadline           DateTime?
  lastSessionEndedAt DateTime?
  kickoffTemplateId  Int?
  lastActivityAt     DateTime          @default(now())
  lastScannedAt      DateTime          @default(now())
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  lessons          KnowledgeLesson[]
  auditSnapshots   AuditSnapshot[]
  activityEvents   ActivityEvent[]
  humanTasks       HumanTask[]
  dispatchOutcomes DispatchOutcome[]
  dispatches       Dispatch[]
  featureUsages    ProjectFeatureUsage[]
  featureProposals FeatureProposal[]
  orgPosts         OrgPost[]
  orgShares        OrgProjectShare[]
  kickoffTemplate  KickoffTemplate?  @relation(fields: [kickoffTemplateId], references: [id])

  // Phase 31 — audit finding [30.D4]. Dashboard, briefing, and
  // overseer-tools-query-projects all `orderBy: { lastActivityAt: "desc" }`.
  @@index([lastActivityAt])
  @@index([status, lastActivityAt])
}

model KnowledgeLesson {
  id              Int       @id @default(autoincrement())
  title           String
  content         String // markdown
  category        String // deployment | auth | database | performance | testing | error-handling | integrations | anti-patterns | architecture | tooling
  sourceProjectId Int?
  sourceFile      String?
  sourcePhase     String?
  tags            String    @default("[]") // JSON array
  severity        String    @default("nice-to-know") // critical | important | nice-to-know
  discoveredAt    DateTime  @default(now())
  verified        Boolean   @default(false)
  timesReferenced Int       @default(0)

  sourceProject Project? @relation(fields: [sourceProjectId], references: [id])
}

model KickoffTemplate {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  content     String // markdown
  projectType String   @default("web-app") // web-app | game | api | mobile | other
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects Project[]
}

model AuditSnapshot {
  id         Int      @id @default(autoincrement())
  projectId  Int
  phase      String
  auditType  String // test-audit | bughunt | optimize | drift-audit
  grade      String?
  findings   String   @default("{}") // JSON
  isRead     Boolean  @default(false)
  capturedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
}

model ActivityEvent {
  id        Int      @id @default(autoincrement())
  projectId Int?
  eventType String // commit | phase-complete | audit-complete | lesson-harvested | advisory-sent | project-created | blocker-detected | debt-resolved | session-complete
  summary   String
  details   String? // JSON
  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id])

  // Phase 31 — audit finding [30.D4]. ActivityFeed polls every 30s
  // with `orderBy: createdAt desc`; briefing filters `where: createdAt gte`.
  @@index([createdAt])
  @@index([projectId, createdAt])
}

model DispatchOutcome {
  id             Int      @id @default(autoincrement())
  projectId      Int
  projectSlug    String
  mode           String // continue, audit, investigate, custom
  healthAtDispatch String // healthy, warning, blocked, idle
  outcome        String // success, blocker, attention-needed, test-failure, unknown
  signals        String   @default("[]") // JSON array of escalation signal types detected
  dispatchedAt   DateTime
  completedAt    DateTime @default(now())
  // Phase 23.2 — link outcome to its originating Dispatch row.
  // Nullable for backfill of pre-23.2 rows; new rows must populate.
  dispatchId     String?  @unique
  // Phase 41.2 — goal-driven dispatch outcomes. goalCondition is the
  // /goal condition composed at dispatch (null for ad-hoc dispatches);
  // goalAchieved is the evaluator verdict parsed from the session log
  // (null = no verdict surfaced); goalReason is the evaluator's stated
  // reason when present.
  goalCondition  String?
  goalAchieved   Boolean?
  goalReason     String?

  project  Project   @relation(fields: [projectId], references: [id])
  dispatch Dispatch? @relation(fields: [dispatchId], references: [id])
}

// Phase 23.2 — first-class Dispatch lifecycle row.
// Written at enqueue, transitioned by the dispatcher and webhook,
// timed-out by the watchdog. The idempotencyKey is the canonical
// correlation handle between the dispatcher, the spawned Claude Code
// session (passed via CASCADE_DISPATCH_ID env), and the Stop-hook
// webhook.
model Dispatch {
  id               String           @id @default(cuid())
  idempotencyKey   String           @unique @default(cuid())
  projectId        Int
  projectSlug      String
  mode             String                                  // continue | audit | investigate | custom
  customPrompt    String?
  status           String           @default("queued")     // queued | started | completed | failed | timeout
  prompt           String?
  healthAtDispatch String?
  expectedBy       DateTime?
  enqueuedAt       DateTime         @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  errorMessage     String?
  // Phase 45 — team visibility. Nullable + backward-compatible: existing
  // single-user dispatches have no team and are unaffected.
  organizationId   String?
  ownerUserId      String?
  // 52.1 — where this dispatch executes: local (tmux, operator machine)
  // or cloud (Agent SDK runner service). Cloud rows carry runnerId while
  // claimed and costUsd from the SDK result message.
  runtime          String           @default("local")
  runnerId         String?
  costUsd          Float?
  // 52.4 — branch the runner pushed the session's commits to (null = nothing pushed)
  resultBranch     String?
  // 52.5 — PR opened for resultBranch (null = none opened)
  resultPrUrl      String?

  outcome          DispatchOutcome?
  project          Project          @relation(fields: [projectId], references: [id])
  organization     Organization?    @relation(fields: [organizationId], references: [id])
  owner            User?            @relation("DispatchOwner", fields: [ownerUserId], references: [id])

  @@index([projectId, status])
  @@index([expectedBy])
  @@index([status])
  @@index([organizationId])
}

// Phase 12A.1 — ChatSession owns conversation state.
// workingMemory is the structured session-scoped JSON document that
// the Overseer reads and writes via tools (replaces the prior
// "stuff-everything-in-the-system-prompt" pattern).
model ChatSession {
  id            String        @id @default(cuid())
  startedAt     DateTime      @default(now())
  closedAt      DateTime?
  activeFlow        String?       // "inventory_walk" | "dispatch_planning" | "incident_triage" | null
  workingMemory     String        @default("{}") // JSON string
  // Phase 12E — cached summary of the older portion of the conversation.
  // JSON: {summarizedThroughMessageCount, summary}.
  compressedHistory String?

  messages          ChatMessage[]

  @@index([startedAt])
  @@index([closedAt])
}

model ChatMessage {
  id          Int          @id @default(autoincrement())
  role        String // user | assistant
  content     String
  sessionDate String // YYYY-MM-DD, groups conversations by day
  sessionId   String?      // Phase 12A.1 — links to ChatSession; optional during transition
  toolCalls   String?      // Phase 12A.1 — JSON string of structured tool invocations
  createdAt   DateTime     @default(now())

  session     ChatSession? @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([sessionDate])
  // Phase 31 — audit finding [30.D4]. /api/overseer/history filters
  // `where: { sessionDate }` and `orderBy: createdAt asc`.
  @@index([sessionDate, createdAt])
}

model HumanTask {
  id          Int       @id @default(autoincrement())
  title       String
  category    String    @default("other") // asset, credential, testing, deploy, review, external, other
  priority    String    @default("normal") // high, normal, low
  status      String    @default("pending") // pending, done
  projectId   Int?
  projectSlug String?
  createdBy   String    @default("claude") // claude, user, delamain
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  // Phase 45 — team visibility. Nullable + backward-compatible.
  organizationId String?
  ownerUserId    String?

  project Project? @relation(fields: [projectId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  owner        User?         @relation("HumanTaskOwner", fields: [ownerUserId], references: [id])

  // Phase 31 — audit finding [30.D4]. /api/tasks and /api/briefing
  // both filter on status; the list endpoint orders by (priority, createdAt).
  @@index([status, priority, createdAt])
  @@index([organizationId])
}

model Reminder {
  id             Int      @id @default(autoincrement())
  message        String
  conditionType  String // project-health, phase-complete, project-deployed, custom
  conditionValue String // e.g., "ratracer:healthy" or "pointpartner:phase-3" or freeform
  projectSlug    String? // optional — which project this relates to
  status         String   @default("pending") // pending, triggered, dismissed
  createdBy      String   @default("delamain") // delamain or user
  createdAt      DateTime @default(now())
  triggeredAt    DateTime?
}

// Phase 11.1 — Anthropic Feature Update Check
// Vendor-agnostic catalog of upstream AI capabilities Cascade tracks.
// Defaults to "anthropic" but the schema allows future vendors.
model UpstreamFeature {
  id                 Int                    @id @default(autoincrement())
  vendor             String                 @default("anthropic")
  name               String
  category           String // hook | skill | slash-command | mcp-server | sub-agent | agent-team | settings-flag | sdk-feature | api-feature | memory | other
  description        String
  integrationRecipe  String
  source             String                 @default("manual") // "manual" | URL | "harvester"
  addedBy            String                 @default("manual") // "manual" | "harvester" | "fetch"
  confidence         Int                    @default(100) // 0-100
  detector           String? // function name in lib/anthropic-feature-detectors.ts (null if no detector yet)
  discoveredAt       DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  usages             ProjectFeatureUsage[]
  proposals          FeatureProposal[]

  @@unique([vendor, name])
}

// Per-project ledger: which features are detected as in use.
// Derived from filesystem audit; never hand-maintained.
model ProjectFeatureUsage {
  id          Int      @id @default(autoincrement())
  projectId   Int
  featureId   Int
  signal      String // free-form: where the detector matched (e.g. ".claude/settings.json hooks.Stop")
  detectedAt  DateTime @default(now())

  project Project         @relation(fields: [projectId], references: [id])
  feature UpstreamFeature @relation(fields: [featureId], references: [id])

  @@unique([projectId, featureId])
  @@index([projectId])
  @@index([featureId])
}

// Phase 11.3 — persistence for feature proposals generated by the
// Anthropic Feature Proposer. Each proposal is a Claude-drafted diff
// for a (project, missing-feature) pair. Status starts at "proposed";
// the user (or a follow-up tool) transitions to accepted/rejected/
// applied via PATCH /api/feature-proposals/[id].
model FeatureProposal {
  id          Int       @id @default(autoincrement())
  projectId   Int
  featureId   Int
  diff        String    // Claude-generated Markdown diff
  status      String    @default("proposed") // proposed | accepted | rejected | applied
  generatedAt DateTime  @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?   // "user" | "claude" | "system"
  notes       String?

  project Project         @relation(fields: [projectId], references: [id])
  feature UpstreamFeature @relation(fields: [featureId], references: [id])

  @@index([projectId])
  @@index([featureId])
  @@index([status])
  @@index([generatedAt])
}

// Phase 24.2 — Tool-call observability.
// One row per `registry.execute(...)` invocation in runToolUseLoop.
// Drives /observability/tools and the `get_tool_call_stats` tool. The
// `resultUsed` column is reserved for a follow-up heuristic; default
// true so absence-of-data doesn't penalize tools.
model ToolCallEvent {
  id            Int      @id @default(autoincrement())
  sessionId     String
  iteration     Int
  toolName      String
  input         String   // JSON, truncated to 4 KB
  outputSize    Int
  success       Boolean
  errorMessage  String?
  durationMs    Int
  resultUsed    Boolean? @default(true)
  createdAt     DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([toolName])
  @@index([createdAt])
}

// Phase 23.3 — Anthropic API usage telemetry.
// Fire-and-forget row written by every Anthropic call site. Drives
// /observability/cache hit-rate visibility and protects 23.4's
// caching rollout from silent regressions.
model AnthropicUsageEvent {
  id                        Int      @id @default(autoincrement())
  callSite                  String   // "overseer.chat" | "summarizer" | "feature-proposer" | "wizard" | "project.chat"
  model                     String
  inputTokens               Int
  cacheReadInputTokens      Int      @default(0)
  cacheCreationInputTokens  Int      @default(0)
  cacheCreation5mTokens     Int      @default(0)
  cacheCreation1hTokens     Int      @default(0)
  outputTokens              Int
  durationMs                Int
  createdAt                 DateTime @default(now())

  @@index([callSite, createdAt])
  @@index([createdAt])
  @@index([model])
}

// Single-row config table for Cascade-wide state.
// First use: track lastSeenClaudeCodeVersion for the version watcher.
model CascadeConfig {
  id                         Int       @id @default(1) // single-row enforced by always upserting id=1
  lastSeenClaudeCodeVersion  String?
  // Phase 47.1 — AI service + chat model override (null = env/default resolution)
  aiService                  String?
  chatModel                  String?
  updatedAt                  DateTime  @updatedAt
}

// ── Phase 43 — Teams foundation ─────────────────────────────────────
// Multi-user identity primitives. Additive + backward-compatible:
// existing single-user data has no Team and is unaffected. Auth (how a
// User authenticates) is a later, gated phase — a User here is identity
// only. See docs/cascade-2.0-team-direction.md.

model User {
  id            String   @id @default(cuid())
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // 54.1 — Better Auth admin plugin
  role       String?   @default("user")
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  // 54.2 — BYOK: user's own Anthropic key, sealed by lib/crypto-box
  anthropicKeyEnc String?
  // 54.5 — ephemeral demo identity (swept by cleanupDemo)
  isDemo Boolean @default(false)

  // Better Auth relations
  sessions    Session[]
  accounts    Account[]
  members     Member[]
  invitations Invitation[]

  // Work attribution (51.3 — teams live on the org plugin now)
  ownedDispatches Dispatch[] @relation("DispatchOwner")
  orgPosts        OrgPost[] @relation("OrgPostAuthor")
  ownedTasks      HumanTask[] @relation("HumanTaskOwner")

  @@unique([email])
  @@map("user")
}




// Phase 48.4 — "Brains": repos designated as knowledge/persona stores
// (e.g. ~/kilroy-brain). Registered from Settings; consumers resolve the
// primary brain via lib/brain-registry.ts (DB -> KILROY_BRAIN_PATH env).
model Brain {
  id           Int       @id @default(autoincrement())
  name         String
  path         String    @unique
  createdAt    DateTime  @default(now())
  lastSyncedAt DateTime?
}


// ── Better Auth core (Phase 51.2; generated by `auth generate`, ids given
// cuid() defaults so direct prisma creates in tests work — BA supplies its
// own ids at runtime, overriding the default) ─────────────────────────────
model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  // 54.1 — Better Auth admin plugin
  impersonatedBy       String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String
  logo        String?
  createdAt   DateTime     @default(now())
  metadata    String?
  members     Member[]
  invitations Invitation[]
  dispatches  Dispatch[]
  humanTasks  HumanTask[]
  posts       OrgPost[]
  projectShares OrgProjectShare[]
  // 54.4b — org's Linear API key, sealed by lib/crypto-box
  linearKeyEnc String?
  // 54.5 — ephemeral demo org
  isDemo Boolean @default(false)

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// 54.1 — invites for INDEPENDENT users (org members come in through the
// organization plugin's Invitation). Consumed by the user.create.before
// invite gate; acceptedAt stamps consumption.
model UserInvite {
  id          String    @id @default(cuid())
  email       String
  token       String    @unique @default(cuid())
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@map("user_invite")
}

// 54.3 — org typed feed: goals, objectives, bug findings, test-hardening
// requests, notes; optionally attached to a shared project.
model OrgPost {
  id             String   @id @default(cuid())
  organizationId String
  projectId      Int?
  authorUserId   String
  type           String // goal | objective | bug | test-request | note
  title          String
  body           String   @default("")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id])
  author       User         @relation("OrgPostAuthor", fields: [authorUserId], references: [id])

  @@index([organizationId, createdAt])
  @@map("org_post")
}

// 54.3 — a project shared into an org (progress visible to members).
model OrgProjectShare {
  id             String   @id @default(cuid())
  organizationId String
  projectId      Int
  sharedById     String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([organizationId, projectId])
  @@map("org_project_share")
}

// ── 54.4 — roadmaps + kanban ─────────────────────────────────────────
// Boards and milestones are org-scoped (organizationId, members) or
// personal (ownerUserId). Exactly one owner field set — enforced in
// lib/boards.ts, not the DB (SQLite-era convention: app-level checks).

model Milestone {
  id             String    @id @default(cuid())
  organizationId String?
  ownerUserId    String?
  title          String
  description    String    @default("")
  status         String    @default("planned") // planned | in_progress | shipped
  targetDate     DateTime?
  position       Float
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tickets Ticket[]

  @@index([organizationId, position])
  @@index([ownerUserId, position])
  @@map("milestone")
}

model Board {
  id             String   @id @default(cuid())
  organizationId String?
  ownerUserId    String?
  name           String
  createdAt      DateTime @default(now())

  columns BoardColumn[]
  tickets Ticket[]

  @@index([organizationId])
  @@index([ownerUserId])
  @@map("board")
}

model BoardColumn {
  id       String @id @default(cuid())
  boardId  String
  name     String
  position Float

  board   Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@index([boardId, position])
  @@map("board_column")
}

model Ticket {
  id             String   @id @default(cuid())
  boardId        String
  columnId       String
  title          String
  description    String   @default("")
  position       Float
  priority       String   @default("normal") // low | normal | high | urgent
  assigneeUserId String?
  milestoneId    String?
  linearIssueId  String?  @unique // 54.4b Linear sync idempotency
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  board     Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column    BoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  milestone Milestone?  @relation(fields: [milestoneId], references: [id])

  @@index([columnId, position])
  @@map("ticket")
}
